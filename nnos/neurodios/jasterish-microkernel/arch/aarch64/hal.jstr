# ============================================================================
# hal.jstr -- AArch64 Hardware Abstraction Layer top-level
# ============================================================================
# Orchestrates architecture initialization and provides the generic kernel
# interface expected by arch-independent code.
#
# Public interface:
#   arch_init(dtb_ptr)    -- initialize UART, GIC, exceptions, timer
#   arch_irq_enable()     -- unmask IRQs at the CPU
#   arch_irq_disable()    -- mask IRQs at the CPU
#   arch_panic(msg)       -- print a message and halt forever
#   kernel_main()         -- common kernel entry point
#   schedule()            -- scheduler stub used by the timer handler
#
# Built-ins assumed from the AArch64 JStar backend:
#   mrs(sysreg), msr(sysreg, value), wfe, read8(addr)
# ============================================================================

# ----------------------------------------------------------------------------
# Physical DTB address passed by the bootloader.
# ----------------------------------------------------------------------------
global dtb_phys_addr
store 0 into dtb_phys_addr

# ----------------------------------------------------------------------------
# Enable and disable IRQs/FIQs at the CPU by manipulating DAIF.
# ----------------------------------------------------------------------------
func arch_irq_enable() {
    msr(DAIFClr, 0xF)
    isb()
    return
}

func arch_irq_disable() {
    msr(DAIFSet, 0xF)
    isb()
    return
}

# ----------------------------------------------------------------------------
# Wait for the next interrupt (WFE on AArch64).
# ----------------------------------------------------------------------------
func arch_halt() {
    wfe
    return
}

# ----------------------------------------------------------------------------
# Print a NUL-terminated string over the PL011, one character at a time.
# ----------------------------------------------------------------------------
func arch_print_string(msg: u64) {
    let p: u64 = msg
    while true {
        let ch: u8 = read8(p)
        if ch == 0 {
            return
        }
        call arch_putc ch
        p = p + 1
    }
    return
}

# ----------------------------------------------------------------------------
# Kernel panic: report the failure and halt.
# ----------------------------------------------------------------------------
func arch_panic(msg: u64) {
    call arch_irq_disable

    # Print a banner and the caller-provided message.
    call arch_print_string "\n!!! KERNEL PANIC: "
    call arch_print_string msg
    call arch_print_string "\n"

    # Halt forever with interrupts disabled.
    while true {
        wfe
    }

    return
}

# ----------------------------------------------------------------------------
# (schedule() and kernel_main() are provided by common/process.jstr and
# common/kernel.jstr respectively once the compiler can link the full kernel.)

# ============================================================================
# HAL driver registration table (Task 20)
# ============================================================================
# Simple driver registry indexed by compatible string. Each entry stores a
# NUL-terminated compatible string and the address of its init function.
#
# Note: The AArch64 JStar backend does not yet support indirect function
# calls, so hal_init_from_fdt() dispatches via the hardcoded hal_dispatch()
# switch below. The table still records the function addresses so the design
# remains intact once the backend grows indirect-call support.

# ----------------------------------------------------------------------------
# Table configuration
# ----------------------------------------------------------------------------
global HAL_MAX_DRIVERS
store 16 into HAL_MAX_DRIVERS

global HAL_COMPAT_LEN
store 64 into HAL_COMPAT_LEN

global g_driver_count
store 0 into g_driver_count

global g_driver_compat
array 1024 g_driver_compat   # 16 entries * 64 bytes per compatible string

global g_driver_init
array 16 g_driver_init       # 16 function addresses

# ----------------------------------------------------------------------------
# Copy a NUL-terminated compatible string into the table slot.
# ----------------------------------------------------------------------------
func hal_copy_compat(slot: u32, compatible: u64) {
    let dst: u64 = g_driver_compat + (slot * HAL_COMPAT_LEN)
    let src: u64 = compatible
    let i: u64 = 0
    while i < HAL_COMPAT_LEN {
        let ch: u8 = read8(src + i)
        write8(dst + i, ch)
        if ch == 0 {
            return
        }
        i = i + 1
    }
    return
}

# ----------------------------------------------------------------------------
# Register a driver. compatible is a pointer to a NUL-terminated string;
# init is a function address obtained with label_addr().
# ----------------------------------------------------------------------------
func hal_register_driver(compatible: u64, init: u64) {
    let idx: u32 = g_driver_count
    if idx >= HAL_MAX_DRIVERS {
        return
    }
    call hal_copy_compat idx compatible
    store init into g_driver_init at idx
    g_driver_count = g_driver_count + 1
    return
}

# ----------------------------------------------------------------------------
# Hardcoded dispatch helper. Index order must match the order in which
# drivers are registered by hal_register_qemu_drivers() and
# hal_register_pixel_stubs().
# ----------------------------------------------------------------------------
func hal_dispatch(idx: u32, node: u64) -> u32 {
    if idx == 0 {
        return pl011_init(node)
    }
    if idx == 1 {
        return gicv2_init(node)
    }
    if idx == 2 {
        return gicv3_stub_init(node)
    }
    if idx == 3 {
        return ufs_stub_init(node)
    }
    if idx == 4 {
        return pmic_stub_init(node)
    }
    return 1
}

# ----------------------------------------------------------------------------
# Walk the registered drivers and, for each one that has a matching node in
# the DTB, invoke its init function.
# ----------------------------------------------------------------------------
func hal_init_from_fdt() {
    let i: u32 = 0
    while i < g_driver_count {
        let compat: u64 = g_driver_compat + (i * HAL_COMPAT_LEN)
        let node: u64 = fdt_find_node(compat)
        if node != 0 {
            call hal_dispatch i node
        }
        i = i + 1
    }
    return
}

# ----------------------------------------------------------------------------
# Register the QEMU 'virt' drivers.
# ----------------------------------------------------------------------------
func hal_register_qemu_drivers() {
    let pl011_addr: u64 = label_addr(pl011_init)
    let gicv2_addr: u64 = label_addr(gicv2_init)
    call hal_register_driver "arm,pl011" pl011_addr
    call hal_register_driver "arm,cortex-a15-gic" gicv2_addr
    return
}

# ----------------------------------------------------------------------------
# Register Pixel/Tensor G4 HAL stubs.
# ----------------------------------------------------------------------------
func hal_register_pixel_stubs() {
    let gicv3_addr: u64 = label_addr(gicv3_stub_init)
    let ufs_addr: u64 = label_addr(ufs_stub_init)
    let pmic_addr: u64 = label_addr(pmic_stub_init)
    call hal_register_driver "arm,gic-v3" gicv3_addr
    call hal_register_driver "jedec,ufs-2.1" ufs_addr
    call hal_register_driver "google,tensor-g4-pmic" pmic_addr
    return
}

# ----------------------------------------------------------------------------
# Pixel/Tensor G4 device stubs.
# These decode 'reg' from the node but take no real hardware action.
# ----------------------------------------------------------------------------
func gicv3_stub_init(node: u64) -> u32 {
    let dist_addr: u64 = 0
    let dist_size: u64 = 0
    let redist_addr: u64 = 0
    let redist_size: u64 = 0
    call fdt_get_reg node 0 dist_addr dist_size
    call fdt_get_reg node 1 redist_addr redist_size
    return 0
}

func ufs_stub_init(node: u64) -> u32 {
    let hci_addr: u64 = 0
    let hci_size: u64 = 0
    call fdt_get_reg node 0 hci_addr hci_size
    return 0
}

func pmic_stub_init(node: u64) -> u32 {
    return 0
}

# ----------------------------------------------------------------------------
# Architecture initialization override for FDT-aware bring-up.
# Called from _start in boot.jstr.
# ----------------------------------------------------------------------------
func arch_init(dtb_ptr: u64) {
    dtb_phys_addr = dtb_ptr

    # Initialize the DTB parser.
    let fdt_ok: u32 = fdt_init(dtb_ptr)
    if fdt_ok != 0 {
        # Invalid DTB: continue with hard-coded QEMU 'virt' defaults.
    }

    # Register all known drivers.
    call hal_register_qemu_drivers
    call hal_register_pixel_stubs

    # Attempt FDT-driven driver initialization.
    if fdt_ok == 0 {
        call hal_init_from_fdt
    }

    # Fallback for QEMU 'virt': direct init in case DTB parsing found no
    # matching node or the DTB was missing.
    call uart_init
    call exceptions_init
    call gic_init

    # Use the counter frequency for the timer initialization.
    let freq: u64 = mrs(CNTFRQ_EL0)
    call arch_timer_init freq

    return
}
