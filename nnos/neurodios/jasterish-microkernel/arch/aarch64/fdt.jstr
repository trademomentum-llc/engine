###############################################################################
# fdt.jstr -- Flattened Device Tree parser for AArch64 JMK
###############################################################################
# Minimal big-endian DTB parser used to discover device nodes on QEMU 'virt'
# and future Pixel/Tensor G4 targets.
#
# Public interface:
#   fdt_init(dtb_phys) -> long        -- validate magic and cache header fields
#   fdt_find_node(compatible) -> long -- return absolute address of the matching
#                                       FDT_BEGIN_NODE token, or 0 if not found
#   fdt_get_reg(node, idx, out_addr, out_size) -> long
###############################################################################

# ----------------------------------------------------------------------------
# FDT header and token constants
# ----------------------------------------------------------------------------
global FDT_MAGIC
store 0xD00DFEED into FDT_MAGIC

global FDT_BEGIN_NODE
store 1 into FDT_BEGIN_NODE

global FDT_END_NODE
store 2 into FDT_END_NODE

global FDT_PROP
store 3 into FDT_PROP

global FDT_NOP
store 4 into FDT_NOP

global FDT_END
store 9 into FDT_END

# ----------------------------------------------------------------------------
# Parsed header state. All offsets are relative to the DTB base.
# ----------------------------------------------------------------------------
global fdt_base
store 0 into fdt_base

global fdt_struct_off
store 0 into fdt_struct_off

global fdt_strings_off
store 0 into fdt_strings_off

global fdt_struct_size
store 0 into fdt_struct_size

# ----------------------------------------------------------------------------
# Read a big-endian 32-bit word one byte at a time.
# ----------------------------------------------------------------------------
function fdt_read32_be with long addr
    a b0
    a b1
    a b2
    a b3
    a tmp
    a result

    call mmio_read8 addr
    store it into b0
    add addr 1
    store it into tmp
    call mmio_read8 tmp
    store it into b1
    add addr 2
    store it into tmp
    call mmio_read8 tmp
    store it into b2
    add addr 3
    store it into tmp
    call mmio_read8 tmp
    store it into b3

    shift b0 24
    store it into result
    shift b1 16
    store it into tmp
    bitor result tmp
    store it into result
    shift b2 8
    store it into tmp
    bitor result tmp
    store it into result
    bitor result b3
    store it into result
    return result
end

# ----------------------------------------------------------------------------
# Read a big-endian 64-bit word as two 32-bit halves.
# ----------------------------------------------------------------------------
function fdt_read64_be with long addr
    a hi
    a lo
    a tmp
    a result

    call fdt_read32_be addr
    store it into hi
    add addr 4
    store it into tmp
    call fdt_read32_be tmp
    store it into lo
    shift hi 32
    store it into result
    bitor result lo
    store it into result
    return result
end

# ----------------------------------------------------------------------------
# Initialize the parser from a physical DTB address.
# Returns 0 on success, 1 if the magic is wrong or the header is out of bounds.
# ----------------------------------------------------------------------------
function fdt_init with long dtb_phys
    a magic
    a totalsize
    a tmp
    a off_dt_struct
    a off_dt_strings
    a size_dt_strings
    a size_dt_struct

    store dtb_phys into fdt_base
    call fdt_read32_be dtb_phys
    store it into magic
    if compare magic FDT_MAGIC
        store 0 into fdt_base
        return 1
    end

    add dtb_phys 4
    store it into tmp
    call fdt_read32_be tmp
    store it into totalsize

    # The fixed FDT header is 40 bytes long. Reject any image that does not
    # even contain the full header before reading the remaining fields.
    if less totalsize 40
        store 0 into fdt_base
        return 1
    end

    add dtb_phys 8
    store it into tmp
    call fdt_read32_be tmp
    store it into off_dt_struct
    add dtb_phys 12
    store it into tmp
    call fdt_read32_be tmp
    store it into off_dt_strings
    add dtb_phys 32
    store it into tmp
    call fdt_read32_be tmp
    store it into size_dt_strings
    add dtb_phys 36
    store it into tmp
    call fdt_read32_be tmp
    store it into size_dt_struct

    # Basic bounds validation: all header offsets and block sizes must lie
    # inside the DTB image described by totalsize. These checks catch
    # truncated or corrupt DTBs early, before the token walker reads past
    # the DTB boundary. (a >= b is tested as the two separate cases
    # a > b and a == b.)
    if greater off_dt_struct totalsize
        store 0 into fdt_base
        return 1
    end
    if equal off_dt_struct totalsize
        store 0 into fdt_base
        return 1
    end
    if greater off_dt_strings totalsize
        store 0 into fdt_base
        return 1
    end
    if equal off_dt_strings totalsize
        store 0 into fdt_base
        return 1
    end
    if greater size_dt_strings totalsize
        store 0 into fdt_base
        return 1
    end
    if greater size_dt_struct totalsize
        store 0 into fdt_base
        return 1
    end
    subtract totalsize size_dt_strings
    store it into tmp
    if greater off_dt_strings tmp
        store 0 into fdt_base
        return 1
    end
    subtract totalsize size_dt_struct
    store it into tmp
    if greater off_dt_struct tmp
        store 0 into fdt_base
        return 1
    end

    store off_dt_struct into fdt_struct_off
    store off_dt_strings into fdt_strings_off
    store size_dt_struct into fdt_struct_size
    return 0
end

# ----------------------------------------------------------------------------
# Compare two NUL-terminated strings.
# Returns 1 if equal, 0 otherwise.
# ----------------------------------------------------------------------------
function fdt_streq with long stra with long strb
    a i
    a ptra
    a ptrb
    a ca
    a cb

    store 0 into i
    while true
        add stra i
        store it into ptra
        call mmio_read8 ptra
        store it into ca
        add strb i
        store it into ptrb
        call mmio_read8 ptrb
        store it into cb
        if compare ca cb
            return 0
        end
        if equal ca 0
            return 1
        end
        add i 1
        store it into i
    end
    return 0
end

# ----------------------------------------------------------------------------
# Length of a NUL-terminated string.
# ----------------------------------------------------------------------------
function fdt_strlen with long s
    a len
    a ptr
    a ch

    store 0 into len
    store 1 into ch
    while compare ch 0
        add s len
        store it into ptr
        call mmio_read8 ptr
        store it into ch
        if compare ch 0
            add len 1
            store it into len
        end
    end
    return len
end

# ----------------------------------------------------------------------------
# Skip a NUL-terminated, 4-byte aligned name that follows a token.
# ----------------------------------------------------------------------------
function fdt_skip_name with long p
    a len
    a total
    a rem

    call fdt_strlen p
    store it into len
    add len 1
    store it into total

    store 1 into rem
    while compare rem 0
        bitand total 3
        store it into rem
        if compare rem 0
            add total 1
            store it into total
        end
    end

    add p total
    store it into total
    return total
end

# ----------------------------------------------------------------------------
# Find the first node whose 'compatible' property contains the requested
# compatible string. Returns the absolute address of the node's FDT_BEGIN_NODE
# token, or 0 if not found.
# ----------------------------------------------------------------------------
function fdt_find_node with long compatible
    a base
    a p
    a struct_end
    a current_node
    a token
    a len
    a nameoff
    a data
    a name
    a tmp
    a streq_result
    a offset
    a cand
    a sublen
    a next
    a align_rem

    store fdt_base into base
    if equal base 0
        return 0
    end
    add base fdt_struct_off
    store it into p
    add p fdt_struct_size
    store it into struct_end
    store 0 into current_node

    while less p struct_end
        call fdt_read32_be p
        store it into token

        if equal token FDT_BEGIN_NODE
            store p into current_node
            add p 4
            store it into tmp
            call fdt_skip_name tmp
            store it into p
        else
            if equal token FDT_END_NODE
                store 0 into current_node
                add p 4
                store it into p
            else
                if equal token FDT_PROP
                    add p 4
                    store it into tmp
                    call fdt_read32_be tmp
                    store it into len
                    add p 8
                    store it into tmp
                    call fdt_read32_be tmp
                    store it into nameoff
                    add p 12
                    store it into data
                    add base fdt_strings_off
                    add it nameoff
                    store it into name
                    if compare current_node 0
                        call fdt_streq name "compatible"
                        store it into streq_result
                        if equal streq_result 1
                            store 0 into offset
                            while less offset len
                                add data offset
                                store it into cand
                                call fdt_streq cand compatible
                                store it into streq_result
                                if equal streq_result 1
                                    return current_node
                                end
                                call fdt_strlen cand
                                store it into sublen
                                if equal sublen 0
                                    store len into offset
                                else
                                    add offset sublen
                                    add it 1
                                    store it into offset
                                end
                            end
                        end
                    end
                    add p 12
                    add it len
                    store it into next
                    store 1 into align_rem
                    while compare align_rem 0
                        subtract next base
                        subtract it fdt_struct_off
                        bitand it 3
                        store it into align_rem
                        if compare align_rem 0
                            add next 1
                            store it into next
                        end
                    end
                    store next into p
                else
                    if equal token FDT_NOP
                        add p 4
                        store it into p
                    else
                        if equal token FDT_END
                            return 0
                        else
                            return 0
                        end
                    end
                end
            end
        end
    end
    return 0
end

# ----------------------------------------------------------------------------
# Read the idx-th (addr, size) pair from the node's 'reg' property.
#
# WARNING: This function hard-codes 64-bit address and size cells, i.e. it
# assumes #address-cells=2 and #size-cells=2. It does NOT parse the parent
# #address-cells / #size-cells properties, nor does it handle 32-bit cells.
# This is acceptable for the current QEMU 'virt' and Pixel/Tensor G4 stubs,
# where ARM64 device trees conventionally use two 32-bit cells per field.
# A full implementation would walk the parent chain and scale pair_size by
# the actual cell counts.
#
# Writes the pair to the addresses given by out_addr and out_size.
# Returns 0 on success.
# ----------------------------------------------------------------------------
function fdt_get_reg with long node with long idx with long out_addr with long out_size
    a base
    a p
    a depth
    a token
    a len
    a nameoff
    a data
    a name
    a tmp
    a streq_result
    a pair_size
    a offset
    a total
    a addr
    a size
    a next
    a align_rem

    store fdt_base into base
    if equal base 0
        return 1
    end
    if equal node 0
        return 1
    end
    add node 4
    store it into tmp
    call fdt_skip_name tmp
    store it into p
    store 0 into depth

    while true
        call fdt_read32_be p
        store it into token
        if equal token FDT_END_NODE
            if equal depth 0
                return 1
            end
            subtract depth 1
            store it into depth
            add p 4
            store it into p
        else
            if equal token FDT_PROP
                add p 4
                store it into tmp
                call fdt_read32_be tmp
                store it into len
                add p 8
                store it into tmp
                call fdt_read32_be tmp
                store it into nameoff
                add p 12
                store it into data
                add base fdt_strings_off
                add it nameoff
                store it into name
                if equal depth 0
                    call fdt_streq name "reg"
                    store it into streq_result
                    if equal streq_result 1
                        store 16 into pair_size
                        multiply idx pair_size
                        store it into offset
                        add offset pair_size
                        store it into total
                        if greater total len
                            return 1
                        end
                        add data offset
                        store it into tmp
                        call fdt_read64_be tmp
                        store it into addr
                        add data offset
                        add it 8
                        store it into tmp
                        call fdt_read64_be tmp
                        store it into size
                        call mmio_write64 out_addr addr
                        call mmio_write64 out_size size
                        return 0
                    end
                end
                add p 12
                add it len
                store it into next
                store 1 into align_rem
                while compare align_rem 0
                    subtract next base
                    subtract it fdt_struct_off
                    bitand it 3
                    store it into align_rem
                    if compare align_rem 0
                        add next 1
                        store it into next
                    end
                end
                store next into p
            else
                if equal token FDT_BEGIN_NODE
                    add depth 1
                    store it into depth
                    add p 4
                    store it into tmp
                    call fdt_skip_name tmp
                    store it into p
                else
                    if equal token FDT_NOP
                        add p 4
                        store it into p
                    else
                        return 1
                    end
                end
            end
        end
    end
    return 1
end
