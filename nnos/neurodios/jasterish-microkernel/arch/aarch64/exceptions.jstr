###############################################################################
# exceptions.jstr -- AArch64 exception vector table
###############################################################################
# Sets up the EL1 vector table for the Jasterish Micro-Kernel AArch64 port.
#
# Public interface:
#   exceptions_init()  -- build and install the VBAR_EL1 vector table
#
# The vector table is 2048 bytes and must be 2048-byte aligned.  It contains
# 16 entries, each 128 bytes.  Every entry is patched at runtime with an
# AArch64 unconditional branch to the appropriate handler.
###############################################################################

# ----------------------------------------------------------------------------
# Vector-table constants
# ----------------------------------------------------------------------------
global VECTOR_TABLE_SIZE
store 2048 into VECTOR_TABLE_SIZE

# ----------------------------------------------------------------------------
# Scratch argument array for the synchronous exception (SVC) dispatch path.
# The AArch64 backend currently does not support local arrays here, so a
# small global array is used instead.
# ----------------------------------------------------------------------------
global syscall_args
array 6 syscall_args

global VECTOR_ENTRY_SIZE
store 128 into VECTOR_ENTRY_SIZE

global VECTOR_GROUP_COUNT
store 4 into VECTOR_GROUP_COUNT

global BRANCH_OPCODE
store 0x14000000 into BRANCH_OPCODE

# ----------------------------------------------------------------------------
# Backing storage for the vector table.  A 4096-byte array is declared, then
# the actual VBAR address is computed as the next 2KB-aligned offset inside
# it (so we are guaranteed alignment regardless of how the linker lays out
# the symbol).
# ----------------------------------------------------------------------------
global vector_table
array 512 vector_table

# ----------------------------------------------------------------------------
# Compute a 2048-byte aligned vector-table base address.
# vector_table is 4096 bytes, so aligning down to the nearest 2048-byte
# boundary inside it is guaranteed to leave 2048 valid bytes.
# NOTE: the compiler miscompiles 0xFFFFFFFFFFFFFFFF as an immediate, so we
# use shift-down/up instead of (addr + align) & ~align.
# ----------------------------------------------------------------------------
function vector_table_base
    a base
    a raw

    addressof vector_table
    store it into raw
    shift_right it 11
    shift_left it 11
    store it into base
    return base
end

# ----------------------------------------------------------------------------
# Patch a single vector entry with a branch to the target handler.
# The AArch64 unconditional branch encoding is:
#   0x14000000 | ((target - entry) >> 2)
# ----------------------------------------------------------------------------
function vector_write_branch with long entry with long target
    a offset
    a masked
    a insn

    subtract target entry
    store it into register x0
    inline "asr x0, x0, 2"
    store register x0 into offset
    bitand offset 0x03FFFFFF
    store it into masked
    bitor BRANCH_OPCODE masked
    store it into insn
    call mmio_write32 entry insn

    return 0
end

# ----------------------------------------------------------------------------
# Patch all four entries of one vector kind (sync/irq/fiq/serr).
# kind_offset: 0 = sync, 1 = irq, 2 = fiq, 3 = serr.
# ----------------------------------------------------------------------------
function vector_patch_kind with long base with long handler_addr with long kind_offset
    a i
    a idx
    a scaled
    a entry

    store 0 into i
    while less i VECTOR_GROUP_COUNT
        multiply i 4
        add it kind_offset
        store it into idx
        multiply idx VECTOR_ENTRY_SIZE
        store it into scaled
        add base scaled
        store it into entry
        call vector_write_branch entry handler_addr
        add i 1
        store it into i
    end
    return 0
end

# ----------------------------------------------------------------------------
# Install the vector table and point VBAR_EL1 at it.
# ----------------------------------------------------------------------------
function exceptions_init
    a base
    a sync_addr
    a irq_addr
    a fiq_addr
    a serr_addr

    call vector_table_base
    store it into base

    inline "adr x0, sync_handler"
    store register x0 into sync_addr
    inline "adr x0, irq_handler"
    store register x0 into irq_addr
    inline "adr x0, fiq_handler"
    store register x0 into fiq_addr
    inline "adr x0, serr_handler"
    store register x0 into serr_addr

    call vector_patch_kind base sync_addr 0
    call vector_patch_kind base irq_addr 1
    call vector_patch_kind base fiq_addr 2
    call vector_patch_kind base serr_addr 3

    store base into register x0
    inline "msr vbar_el1, x0"
    inline "isb"

    return 0
end

# ----------------------------------------------------------------------------
# Exception handlers.  Context save/restore is intentionally omitted at this
# stage; the compiler backend does not yet expose low-level assembly prologue
# primitives.  These handlers provide the required dispatch shape.
# ----------------------------------------------------------------------------
function sync_handler
    a esr
    a tmp
    a ec
    a num
    a args_ptr
    a arg0
    a arg1
    a arg2
    a arg3
    a arg4
    a arg5

    inline "mrs x0, esr_el1"
    store register x0 into esr

    # ec = (esr >> 26) & 0x3F
    store esr into register x0
    inline "lsr x0, x0, 26"
    store register x0 into tmp
    bitand tmp 0x3F
    store it into ec

    if equal ec 0x15
        # SVC from AArch64: treat x8 as the syscall number and x0-x5
        # as the argument list.  Save the argument registers first;
        # reading x8 into x0 would clobber the first argument.
        store register x0 into arg0
        store register x1 into arg1
        store register x2 into arg2
        store register x3 into arg3
        store register x4 into arg4
        store register x5 into arg5
        store arg0 into syscall_args at 0
        store arg1 into syscall_args at 1
        store arg2 into syscall_args at 2
        store arg3 into syscall_args at 3
        store arg4 into syscall_args at 4
        store arg5 into syscall_args at 5

        inline "mov x0, x8"
        store register x0 into num

        addressof syscall_args
        store it into args_ptr
        call syscall_dispatch num args_ptr
        # The return value is left in the JStar implicit result register;
        # the backend is responsible for mapping it to x0 on return to EL0.
        return 0
    end

    call arch_panic "synchronous exception"
    return 0
end

function irq_handler
    a irq

    call gic_iar
    store it into irq

    if equal irq TIMER_IRQ
        call timer_irq_handler
    end

    call gic_eoi irq
    return 0
end

function fiq_handler
    call arch_panic "FIQ"
    return 0
end

function serr_handler
    call arch_panic "SError"
    return 0
end
