###############################################################################
# driver_registry.jstr -- AArch64 HAL driver registry
###############################################################################
# Device-tree driven driver registration table. This file is kept separate
# from the generic AArch64 HAL so that board-specific and QEMU 'virt' driver
# registration can evolve without coupling to the core bring-up code.
#
# Public interface:
#   hal_register_qemu_drivers()  -- register the QEMU 'virt' drivers
#   hal_register_pixel_stubs()   -- register Pixel/Tensor G4 stubs
#   hal_init_from_fdt()          -- initialize drivers found in the DTB
#
# Note: The AArch64 JStar backend does not yet support indirect function
# calls, so hal_init_from_fdt() dispatches via the hardcoded hal_dispatch()
# switch below. The table still records the function addresses so the design
# remains intact once the backend grows indirect-call support.
###############################################################################

# ----------------------------------------------------------------------------
# Table configuration
# ----------------------------------------------------------------------------
global HAL_MAX_DRIVERS
store 16 into HAL_MAX_DRIVERS

global HAL_COMPAT_LEN
store 64 into HAL_COMPAT_LEN

global g_driver_count
store 0 into g_driver_count

# 16 entries * 64 bytes per compatible string (128 * 8 = 1024 bytes)
global g_driver_compat
array 128 g_driver_compat

# 16 function addresses
global g_driver_init
array 16 g_driver_init

# ----------------------------------------------------------------------------
# Copy a NUL-terminated compatible string into the table slot.
# ----------------------------------------------------------------------------
function hal_copy_compat with long slot with long compatible
    a dst
    a scaled
    a src
    a i
    a ptr
    a ch
    a keep_copying

    multiply slot HAL_COMPAT_LEN
    store it into scaled
    addressof g_driver_compat
    add it scaled
    store it into dst
    store compatible into src
    store 0 into i

    store 1 into keep_copying
    while compare keep_copying 0
        add src i
        store it into ptr
        call mmio_read8 ptr
        store it into ch
        add dst i
        store it into ptr
        call mmio_write8 ptr ch
        if equal ch 0
            store 0 into keep_copying
        else
            add i 1
            store it into i
            if equal i HAL_COMPAT_LEN
                store 0 into keep_copying
            end
        end
    end
    return 0
end

# ----------------------------------------------------------------------------
# Register a driver. compatible is a pointer to a NUL-terminated string;
# init is a function address obtained via inline adr.
# ----------------------------------------------------------------------------
function hal_register_driver with long compatible with long init
    a idx

    store g_driver_count into idx
    if greater idx HAL_MAX_DRIVERS
        return 0
    end
    if equal idx HAL_MAX_DRIVERS
        return 0
    end
    call hal_copy_compat idx compatible
    store init into g_driver_init at idx
    add g_driver_count 1
    store it into g_driver_count
    return 0
end

# ----------------------------------------------------------------------------
# Hardcoded dispatch helper. Index order must match the order in which
# drivers are registered by hal_register_qemu_drivers() and
# hal_register_pixel_stubs().
# ----------------------------------------------------------------------------
function hal_dispatch with long idx with long node
    if equal idx 0
        call pl011_init node
        return it
    end
    if equal idx 1
        call gicv2_init node
        return it
    end
    if equal idx 2
        call gicv3_stub_init node
        return it
    end
    if equal idx 3
        call ufs_stub_init node
        return it
    end
    if equal idx 4
        call pmic_stub_init node
        return it
    end
    return 1
end

# ----------------------------------------------------------------------------
# Walk the registered drivers and, for each one that has a matching node in
# the DTB, invoke its init function.
# ----------------------------------------------------------------------------
function hal_init_from_fdt
    a i
    a scaled
    a compat
    a node

    store 0 into i
    while less i g_driver_count
        multiply i HAL_COMPAT_LEN
        store it into scaled
        addressof g_driver_compat
        add it scaled
        store it into compat
        call fdt_find_node compat
        store it into node
        if compare node 0
            call hal_dispatch i node
        end
        add i 1
        store it into i
    end
    return 0
end

# ----------------------------------------------------------------------------
# Register the QEMU 'virt' drivers.
# ----------------------------------------------------------------------------
function hal_register_qemu_drivers
    a pl011_addr
    a gicv2_addr

    inline "adr x0, pl011_init"
    store register x0 into pl011_addr
    inline "adr x0, gicv2_init"
    store register x0 into gicv2_addr
    call hal_register_driver "arm,pl011" pl011_addr
    call hal_register_driver "arm,cortex-a15-gic" gicv2_addr
    return 0
end

# ----------------------------------------------------------------------------
# Register Pixel/Tensor G4 HAL stubs.
# ----------------------------------------------------------------------------
function hal_register_pixel_stubs
    a gicv3_addr
    a ufs_addr
    a pmic_addr

    inline "adr x0, gicv3_stub_init"
    store register x0 into gicv3_addr
    inline "adr x0, ufs_stub_init"
    store register x0 into ufs_addr
    inline "adr x0, pmic_stub_init"
    store register x0 into pmic_addr
    call hal_register_driver "arm,gic-v3" gicv3_addr
    call hal_register_driver "jedec,ufs-2.1" ufs_addr
    call hal_register_driver "google,tensor-g4-pmic" pmic_addr
    return 0
end

# ----------------------------------------------------------------------------
# Pixel/Tensor G4 device stubs.
# These decode 'reg' from the node but take no real hardware action.
# ----------------------------------------------------------------------------
function gicv3_stub_init with long node
    a dist_addr
    a dist_size
    a redist_addr
    a redist_size
    a dist_addr_ptr
    a dist_size_ptr
    a redist_addr_ptr
    a redist_size_ptr

    store 0 into dist_addr
    store 0 into dist_size
    store 0 into redist_addr
    store 0 into redist_size
    addressof dist_addr
    store it into dist_addr_ptr
    addressof dist_size
    store it into dist_size_ptr
    addressof redist_addr
    store it into redist_addr_ptr
    addressof redist_size
    store it into redist_size_ptr
    call fdt_get_reg node 0 dist_addr_ptr dist_size_ptr
    call fdt_get_reg node 1 redist_addr_ptr redist_size_ptr
    return 0
end

function ufs_stub_init with long node
    a hci_addr
    a hci_size
    a hci_addr_ptr
    a hci_size_ptr

    store 0 into hci_addr
    store 0 into hci_size
    addressof hci_addr
    store it into hci_addr_ptr
    addressof hci_size
    store it into hci_size_ptr
    call fdt_get_reg node 0 hci_addr_ptr hci_size_ptr
    return 0
end

function pmic_stub_init with long node
    return 0
end
