###############################################################################
# gic.jstr -- AArch64 GICv2 driver
###############################################################################
# Provides a minimal distributor + CPU-interface driver for the ARM Generic
# Interrupt Controller on QEMU 'virt'.
#
# Public interface:
#   gic_init()              -- enable distributor and CPU interface
#   gic_enable_irq(irq)     -- unmask a peripheral IRQ
#   gic_disable_irq(irq)    -- mask a peripheral IRQ
#   gic_clear_pending(irq)  -- clear a pending peripheral IRQ
#   gic_eoi(irq)            -- signal end-of-interrupt
#   gic_iar() -> long       -- read interrupt acknowledge register
###############################################################################

# ----------------------------------------------------------------------------
# GICv2 memory-mapped base addresses
# ----------------------------------------------------------------------------
global GICD_BASE
store 0x08000000 into GICD_BASE    # Distributor

global GICC_BASE
store 0x08010000 into GICC_BASE    # CPU interface

# Distributor register offsets
global GICD_CTLR
store 0x000 into GICD_CTLR         # Distributor Control Register

global GICD_ISENABLER
store 0x100 into GICD_ISENABLER    # Interrupt Set-Enable Registers

global GICD_ICENABLER
store 0x180 into GICD_ICENABLER    # Interrupt Clear-Enable Registers

global GICD_ICPENDR
store 0x280 into GICD_ICPENDR      # Interrupt Clear-Pending Registers

# CPU interface register offsets
global GICC_CTLR
store 0x000 into GICC_CTLR         # CPU Interface Control Register

global GICC_PMR
store 0x004 into GICC_PMR          # Priority Mask Register

global GICC_BPR
store 0x008 into GICC_BPR          # Binary Point Register

global GICC_IAR
store 0x00C into GICC_IAR          # Interrupt Acknowledge Register

global GICC_EOIR
store 0x010 into GICC_EOIR         # End of Interrupt Register

# Control register values
global GICD_CTLR_ENABLE
store 1 into GICD_CTLR_ENABLE

global GICC_CTLR_ENABLE
store 1 into GICC_CTLR_ENABLE

# ----------------------------------------------------------------------------
# Initialize the GIC: enable distributor, enable CPU interface, allow all
# priorities, and set a sensible binary point.
# ----------------------------------------------------------------------------
function gic_init
    a addr

    add GICD_BASE GICD_CTLR
    store it into addr
    call mmio_write32 addr GICD_CTLR_ENABLE

    add GICC_BASE GICC_PMR
    store it into addr
    call mmio_write32 addr 0xFF

    add GICC_BASE GICC_BPR
    store it into addr
    call mmio_write32 addr 0x00

    add GICC_BASE GICC_CTLR
    store it into addr
    call mmio_write32 addr GICC_CTLR_ENABLE

    return 0
end

# ----------------------------------------------------------------------------
# Enable (unmask) a shared peripheral interrupt.
# ----------------------------------------------------------------------------
function gic_enable_irq with long irq
    a reg
    a bit
    a mask
    a addr

    divide irq 32
    multiply it 4
    store it into reg
    modulo irq 32
    store it into bit
    shift 1 bit
    store it into mask
    add GICD_BASE GICD_ISENABLER
    add it reg
    store it into addr
    call mmio_write32 addr mask
    return 0
end

# ----------------------------------------------------------------------------
# Disable (mask) a shared peripheral interrupt.
# ----------------------------------------------------------------------------
function gic_disable_irq with long irq
    a reg
    a bit
    a mask
    a addr

    divide irq 32
    multiply it 4
    store it into reg
    modulo irq 32
    store it into bit
    shift 1 bit
    store it into mask
    add GICD_BASE GICD_ICENABLER
    add it reg
    store it into addr
    call mmio_write32 addr mask
    return 0
end

# ----------------------------------------------------------------------------
# Clear a pending interrupt.
# ----------------------------------------------------------------------------
function gic_clear_pending with long irq
    a reg
    a bit
    a mask
    a addr

    divide irq 32
    multiply it 4
    store it into reg
    modulo irq 32
    store it into bit
    shift 1 bit
    store it into mask
    add GICD_BASE GICD_ICPENDR
    add it reg
    store it into addr
    call mmio_write32 addr mask
    return 0
end

# ----------------------------------------------------------------------------
# Signal end-of-interrupt to the CPU interface.
# ----------------------------------------------------------------------------
function gic_eoi with long irq
    a addr

    add GICC_BASE GICC_EOIR
    store it into addr
    call mmio_write32 addr irq
    return 0
end

# ----------------------------------------------------------------------------
# Read the Interrupt Acknowledge Register and return the interrupt ID.
# ----------------------------------------------------------------------------
function gic_iar
    a addr
    a iar
    a id

    add GICC_BASE GICC_IAR
    store it into addr
    call mmio_read32 addr
    store it into iar
    bitand iar 0x3FF
    store it into id
    return id
end

# ----------------------------------------------------------------------------
# HAL-compatible init wrapper for the ARM GICv2.
# The node parameter is reserved for future DTB-based base-address discovery.
# ----------------------------------------------------------------------------
function gicv2_init with long node
    call gic_init
    return 0
end
