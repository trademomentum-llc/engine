# Dockerfile.build — Cross-compilation environment for Jasterish Micro-Kernel
# Phase 1, Item 3 of NEURODIOS-BIN-OPT-001
# Usage:
#   docker build -f Dockerfile.build -t jmk-builder .
#   docker run --rm -v $(pwd):/src -w /src jmk-builder make

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install cross-compilation toolchain and QEMU
RUN apt-get update && apt-get install -y \
    build-essential \
    gcc-x86-64-linux-gnu \
    g++-x86-64-linux-gnu \
    binutils-x86-64-linux-gnu \
    qemu-system-x86 \
    xorriso \
    make \
    git \
    && rm -rf /var/lib/apt/lists/*
# Note: grub-pc-bin is x86-only and omitted here; install manually if ISO target needed

# The Jasterish compiler (jstar) must be provided via volume mount
# from the apps/ workspace or installed into the image.
# Default expects jstar at /usr/local/bin/jstar.
ENV JASTERISH_COMPILER=/usr/local/bin/jstar
ENV CROSS_COMPILE=x86_64-linux-gnu-

WORKDIR /src
CMD ["make", "build"]
