use anyhow::{Context, Result};
use serde::Deserialize;
use std::collections::HashMap;
use std::env;
use std::fs;
use tokio::signal;

#[derive(Deserialize, Debug)]
struct TaskSpec {
    node: String,
    atomic_dependencies: Vec<String>,
}

fn load_db_password(path: &str) -> Result<String> {
    let content = fs::read_to_string(path)
        .with_context(|| format!("Failed to read DB password from {}", path))?;
    Ok(content.trim().to_string())
}

#[tokio::main]
async fn main() -> Result<()> {
    tracing_subscriber::fmt::init();
    tracing::info!("LSA State Monitor starting");

    let node_role = env::var("NNOS_NODE_ROLE")
        .context("NNOS_NODE_ROLE not set")?;
    tracing::info!("Node role: {}", node_role);

    let db_pass_path = env::var("NNOS_DB_PASSWORD_FILE")
        .unwrap_or_else(|_| "/etc/lsa/secrets/db_pass".into());
    let db_pass = load_db_password(&db_pass_path)?;
    tracing::info!("DB credentials loaded from: {}", db_pass_path);
    drop(db_pass); // In prod, pass to secure connector; never log

    let tasks_raw = fs::read_to_string("config/tasks.json")?;
    let tasks: HashMap<String, TaskSpec> = serde_json::from_str(&tasks_raw)?;
    tracing::info!("Loaded {} task definitions", tasks.len());

    for (job, spec) in &tasks {
        tracing::info!(
            job = job.as_str(),
            node = spec.node.as_str(),
            deps = spec.atomic_dependencies.join(",").as_str(),
            "Dispatching task"
        );
    }

    tracing::info!("LSA monitoring loop active. Press Ctrl+C to exit.");
    signal::ctrl_c().await?;
    tracing::info!("Graceful shutdown initiated");
    Ok(())
}