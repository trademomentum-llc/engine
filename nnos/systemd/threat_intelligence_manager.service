[Unit]
Description=NNOS Threat Intelligence Manager
Documentation=file:///usr/share/doc/nnos/README.md
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/bin/ThreatIntelligenceManager
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=threat_intelligence_manager
Environment="NNOS_LOG_DIR=/var/log/lsa"

[Install]
WantedBy=multi-user.target
