[Unit]
Description=NNOS Communication Bridge Daemon
Documentation=file:///usr/share/doc/nnos/README.md
After=lsa_boot_hcn.service
Wants=lsa_boot_hcn.service

[Service]
Type=simple
ExecStart=/usr/bin/lsa_comm_bridge
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lsa_comm_bridge
Environment="NNOS_LOG_DIR=/var/log/lsa"

[Install]
WantedBy=multi-user.target
